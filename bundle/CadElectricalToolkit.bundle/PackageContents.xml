<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage 
    SchemaVersion="1.0" 
    AutodeskProduct="AutoCAD" 
    ProductType="Application" 
    Name="CadElectricalToolkit" 
    AppVersion="1.0.0" 
    Description="Bo cong cu toi uu ve so do mach dien tren AutoCAD thuong" 
    Author="Antigravity Dev" 
