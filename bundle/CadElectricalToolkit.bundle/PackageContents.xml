        <Command Local="SYNCD" Global="SYNCD" />
        <Command Local="TKPLCIN" Global="TKPLCIN" />
        <Command Local="TKPLCOUT" Global="TKPLCOUT" />
        <Command Local="SYNPLC" Global="SYNPLC" />
        <Command Local="TCCTB" Global="TCCTB" />
        <Command Local="TKCRL" Global="TKCRL" />
        <Command Local="SYNCRL" Global="SYNCRL" />
        <Command Local="KTCRL" Global="KTCRL" />
        <Command Local="TKDMBV" Global="TKDMBV" />
