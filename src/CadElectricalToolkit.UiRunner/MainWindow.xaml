<Window x:Class="CadElectricalToolkit.UiRunner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚡ UI Test Runner &amp; Debugger - CadElectricalToolkit" 
        Height="480" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Modern Button Base -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="PurpleBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="CadElectricalToolkit - UI Test Runner" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                <Border Background="#10B981" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="STANDALONE MODE" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Chạy thử, xem trước và debug giao diện WPF độc lập mà không cần mở AutoCAD." 
                       FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Card 1: AutoNumberingWindow -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🔢" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Giao diện Đánh số thứ tự (AutoNumberingWindow)" FontSize="13.5" FontWeight="Bold" Foreground="#F1F5F9"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Bao gồm 3 tab: Đánh số khung tên (DSTTKBT), Đánh số Block Attribute / Text (DSTT), và Đổi giá trị Attribute hàng loạt (DOIATT)."
                                   FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <WrapPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryBtn}" Content="🏷️ Tab 2: STT Block Attr (DSTT)" 
                                    Margin="0,0,8,6" Click="BtnOpenAttrNumbering_Click"/>
                            <Button Style="{StaticResource SuccessBtn}" Content="📑 Tab 1: STT Khung tên (DSTTKBT)" 
                                    Margin="0,0,8,6" Click="BtnOpenFrameNumbering_Click"/>
                            <Button Style="{StaticResource PurpleBtn}" Content="✏️ Tab 3: Đổi Attribute (DOIATT)" 
                                    Margin="0,0,0,6" Click="BtnOpenBatchAttr_Click"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Card 2: ToolInfoWindow -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="📖" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Bảng tra cứu lệnh &amp; Trợ giúp (ToolInfoWindow)" FontSize="13.5" FontWeight="Bold" Foreground="#F1F5F9"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Hiển thị danh sách 25+ lệnh CAD, lọc theo danh mục (Relay, Khung tên, Dây, PLC...), tìm kiếm từ khóa và chức năng copy lệnh (ELECINFO / TT)."
                                   FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Style="{StaticResource PurpleBtn}" Content="🔍 Mở Bảng tra cứu lệnh" 
                                    Click="BtnOpenToolInfo_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Info -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="💡 Mẹo: Khi ứng dụng đang chạy, bạn có thể sửa trực tiếp mã XAML trong Visual Studio để xem kết quả ngay (XAML Hot Reload)." 
                       FontSize="11" Foreground="#64748B"/>
        </Border>
    </Grid>
</Window>
