<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    
    <!-- Path to AutoCAD 2021 installation -->
    <AutoCadPath Condition="'$(AutoCadPath)' == ''">C:\Program Files\Autodesk\AutoCAD 2021</AutoCadPath>
  </PropertyGroup>

  <!-- AutoCAD .NET Assemblies (CopyLocal = False is required for AutoCAD plugins) -->
  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCadPath)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCadPath)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCadPath)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToBundle" AfterTargets="Build">
    <ItemGroup>
      <OutputDlls Include="$(TargetDir)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(OutputDlls)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\bundle\CadElectricalToolkit.bundle\Contents\$(TargetFramework)\" SkipUnchangedFiles="true" />
  </Target>

</Project>
