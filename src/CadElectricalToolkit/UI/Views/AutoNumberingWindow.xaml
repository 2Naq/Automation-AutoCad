<Window x:Class="CadElectricalToolkit.UI.Views.AutoNumberingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ĐÁNH SỐ THỨ TỰ" 
        Height="650" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Red Section Header (matching screenshot) -->
        <Style x:Key="RedSectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Modern TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <!-- Modern ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#242526" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#000000" CornerRadius="4" Width="32" Height="32" Margin="0,0,10,0" Padding="3,0,3,0">
                    <TextBlock Text="AN" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ĐÁNH SỐ THỨ TỰ TỰ ĐỘNG" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="Hỗ trợ Block Attribute, Khung tên và Text/MText" Foreground="#94A3B8" FontSize="10.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl x:Name="TabControlMain" Grid.Row="1" Margin="8,6,8,4" Background="Transparent" BorderThickness="0" SelectionChanged="TabControlMain_SelectionChanged">
            
            <!-- ========================================== -->
            <!-- TAB 1: STT KHUNG TÊN                        -->
            <!-- ========================================== -->
            <TabItem x:Name="TabItemFrame" Header="STT khung tên" FontWeight="SemiBold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel>
                        <!-- Quy tắc đánh số -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Quy tắc đánh số thứ tự" Style="{StaticResource RedSectionHeader}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Prefix" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtFramePrefix" TextChanged="FrameRule_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Kiểu đánh số" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CboFrameNumberStyle" SelectionChanged="FrameRule_Changed">
                                            <ComboBoxItem Content="1,2,3,..." IsSelected="True"/>
                                            <ComboBoxItem Content="A,B,C,..."/>
                                            <ComboBoxItem Content="I,II,III,..."/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Suffix" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtFrameSuffix" TextChanged="FrameRule_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="From:" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtFrameFrom" Grid.Column="1" Text="1" TextAlignment="Center" TextChanged="FrameRule_Changed"/>
                                    <CheckBox x:Name="ChkFrameTwoDigits" Grid.Column="3" Content="Sử dụng hai chữ số (01, 02...)" IsChecked="True" VerticalAlignment="Center" Checked="FrameRule_Changed" Unchecked="FrameRule_Changed"/>
                                </Grid>

                                <!-- Preview Badge -->
                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,4,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Preview: " FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblFramePreview" Text="01" FontWeight="Bold" FontSize="14" Foreground="#DC2626" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Cài đặt tổng trang TSHEET -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Cài đặt tổng số trang (TSHEET)" FontWeight="Bold" FontSize="12" Foreground="#15803D" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkFramePageMode" Content="Cập nhật tổng trang (TSHEET)" IsChecked="True" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center" Checked="FramePage_Changed" Unchecked="FramePage_Changed"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                        <TextBlock Text="Tag:" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtFrameTotalPagesTag" Text="TSHEET" Width="60" FontWeight="Bold" Foreground="#15803D" TextChanged="FramePage_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                        <TextBlock Text="Ký tự:" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtFrameTotalPagesPrefix" Text="/" Width="30" TextAlignment="Center" FontWeight="Bold" TextChanged="FramePage_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkFrameAutoTotal" Content="Tự tính theo số khung chọn" IsChecked="True" VerticalAlignment="Center" Checked="FramePage_Changed" Unchecked="FramePage_Changed"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                                        <TextBlock Text="Cố định:" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtFrameTotalPages" Text="24" Width="48" TextAlignment="Center" TextChanged="FramePage_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="LblFramePagePreview" Text="VD: A00='01', TSHEET='/24' (Hiển thị: 01 /24)" FontStyle="Italic" FontSize="11" Foreground="#15803D" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Thông tin khung tên -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Thông tin khung tên mục tiêu" Style="{StaticResource SectionHeader}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Block name:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtFrameBlockName" Grid.Column="1" Text="Frame-a4" FontWeight="Bold" Foreground="#B91C1C"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Attribute TAG:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtFrameAttrTag" Grid.Column="1" Text="A00" FontWeight="Bold" Foreground="#B91C1C"/>
                                    <Button x:Name="BtnFrameChooseTag" Grid.Column="2" Width="80" Content="🎯 Chọn TAG " Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="BtnChooseTag_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hướng:" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CboFrameDirection" Grid.Column="1">
                                        <ComboBoxItem Content="1. Trái => Phải | Trên => Dưới" IsSelected="True"/>
                                        <ComboBoxItem Content="2. Trái => Phải | Dưới => Trên"/>
                                        <ComboBoxItem Content="3. Trên => Dưới | Trái => Phải"/>
                                        <ComboBoxItem Content="4. Dưới => Trên | Trái => Phải"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action Button Tab Frame -->
                        <Button x:Name="BtnFrameSelectBlocks" Content="⚡ QUÉT CHỌN &amp; ÁP DỤNG CHO KHUNG TÊN" Style="{StaticResource PrimaryButton}" Height="36" Margin="0,2,0,4" Click="BtnFrameSelectBlocks_Click"/>
                        <TextBlock x:Name="TxtFrameStatus" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 2: STT BLOCK ATTRIBUTE (USER FOCUS)    -->
            <!-- ========================================== -->
            <TabItem x:Name="TabItemBlockAttr" Header="STT block attribute" FontWeight="SemiBold" FontSize="12" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel>
                        <!-- Nhóm: Quy tắc đánh số thứ tự -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Quy tắc đánh số thứ tự" Style="{StaticResource RedSectionHeader}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Prefix" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtAttrPrefix" TextChanged="AttrRule_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Kiểu đánh số" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CboAttrNumberStyle" SelectionChanged="AttrRule_Changed">
                                            <ComboBoxItem Content="1,2,3,..." IsSelected="True"/>
                                            <ComboBoxItem Content="A,B,C,..."/>
                                            <ComboBoxItem Content="I,II,III,..."/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Suffix" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtAttrSuffix" TextChanged="AttrRule_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="From:" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtAttrFrom" Grid.Column="1" Text="1" TextAlignment="Center" TextChanged="AttrRule_Changed"/>

                                    <TextBlock Grid.Column="3" Text="Bước:" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                    <TextBox x:Name="TxtAttrStep" Grid.Column="4" Text="1" TextAlignment="Center" TextChanged="AttrRule_Changed"/>

                                    <CheckBox x:Name="ChkAttrTwoDigits" Grid.Column="6" Content="Sử dụng hai chữ số (01...)" IsChecked="False" VerticalAlignment="Center" Checked="AttrRule_Changed" Unchecked="AttrRule_Changed"/>
                                </Grid>

                                <!-- Preview Red Box -->
                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,4,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Preview: " FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblAttrPreview" Text="1" FontWeight="Bold" FontSize="15" Foreground="#DC2626" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Nhóm: Đối tượng mục tiêu -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Đối tượng mục tiêu" Style="{StaticResource SectionHeader}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Block name:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtAttrBlockName" Grid.Column="1" Text="" FontWeight="SemiBold" ToolTip="Tên Block mục tiêu (để trống nếu áp dụng mọi block)"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Attribute TAG:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtAttrTagName" Grid.Column="1" Text="" FontWeight="Bold" Foreground="#B91C1C" ToolTip="Tên thẻ Attribute cần đánh số (ví dụ: TEN_CHAN, WIRE_NO, TB_TAG...)"/>
                                    <Button x:Name="BtnAttrChooseTag" Grid.Column="2" Width="80" Content="🎯 Chọn TAG " Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="BtnChooseTag_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hướng:" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CboAttrDirection" Grid.Column="1">
                                        <ComboBoxItem Content="1. Trái => Phải | Trên => Dưới" IsSelected="True"/>
                                        <ComboBoxItem Content="2. Trái => Phải | Dưới => Trên"/>
                                        <ComboBoxItem Content="3. Trên => Dưới | Trái => Phải"/>
                                        <ComboBoxItem Content="4. Dưới => Trên | Trái => Phải"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="ChkAttrIncludeText" Content="Hỗ trợ cả Text/MText nếu không tìm thấy Attribute" IsChecked="True" FontSize="11" Margin="90,2,0,0" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="350"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAttrSelectBlocks" Grid.Column="0" Content="⚡ QUÉT CHỌN &amp; ÁP DỤNG HÀNG LOẠT" Style="{StaticResource PrimaryButton}" Height="36" Click="BtnAttrSelectBlocks_Click"/>
                            <Button x:Name="BtnAttrPickOneByOne" HorizontalContentAlignment="Center" Grid.Column="2" Content="👆 Click từng cái" Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0" ToolTip="Click chuột liên tục vào từng Text/Block để đánh số tăng dần" Click="BtnAttrPickOneByOne_Click"/>
                        </Grid>

                        <TextBlock x:Name="TxtAttrStatus" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 3: ĐỔI GIÁ TRỊ ATTRIBUTE HÀNG LOẠT    -->
            <!-- ========================================== -->
            <TabItem x:Name="TabItemBatchAttr" Header="Đổi Attribute hàng loạt" FontWeight="SemiBold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel>
                        <!-- Nhóm 1: Block & Attribute mục tiêu -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Block &amp; Attribute mục tiêu" Style="{StaticResource SectionHeader}"/>

                                <!-- Nút chọn mẫu CAD -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnBatchPickSample" Grid.Column="0" Content="  🎯 Chọn Block mẫu trên CAD  " 
                                            Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" 
                                            ToolTip="Click vào một Block trên bản vẽ (ví dụ: COIL) để tự nhận diện Block Name và nạp danh sách Attribute TAG" 
                                            Click="BtnBatchPickSample_Click"/>
                                    <TextBlock x:Name="TxtBatchSampleInfo" Grid.Column="1" Text="(Click để tự nạp Block &amp; TAGs)" 
                                               FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <!-- Block name -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Block name:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtBatchBlockName" Grid.Column="1" Text="" FontWeight="SemiBold" 
                                             TextChanged="BatchRule_Changed"
                                             ToolTip="Tên Block mục tiêu (để trống nếu muốn áp dụng cho mọi block có chứa TAG đã chọn)"/>
                                    <Button x:Name="BtnBatchClearBlockName" Grid.Column="2" Content="  Tất cả  " 
                                            Style="{StaticResource SecondaryButton}" Height="28" Padding="8,0" Margin="4,0,0,0" 
                                            ToolTip="Xóa trống tên block để áp dụng cho bất kỳ block nào có chứa Attribute TAG đã chọn" 
                                            Click="BtnBatchClearBlockName_Click"/>
                                </Grid>

                                <!-- Attribute TAG -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Attribute TAG:" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CboBatchAttrTag" Grid.Column="1" IsEditable="True" 
                                              FontWeight="Bold" Foreground="#B91C1C" 
                                              SelectionChanged="CboBatchAttrTag_SelectionChanged"
                                              TextBoxBase.TextChanged="CboBatchAttrTag_TextChanged"
                                              ToolTip="Chọn Attribute TAG từ danh sách hoặc tự gõ (ví dụ: TERM01, TERM02, MODEL, NAME...)"/>
                                </Grid>

                                <!-- Giá trị mẫu hiện tại -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Giá trị hiện tại:" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtBatchSampleVal" Grid.Column="1" Text="(Chưa chọn mẫu)" 
                                               FontStyle="Italic" Foreground="#475569" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Nhóm 2: Nội dung cần đổi -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Nội dung cần đổi" Style="{StaticResource RedSectionHeader}"/>

                                <!-- RadioButtons chế độ -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RbBatchModeDirect" Grid.Column="0" Content="Gán giá trị mới cố định" 
                                                 IsChecked="True" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155"
                                                 Checked="BatchMode_Changed"/>
                                    <RadioButton x:Name="RbBatchModeReplace" Grid.Column="1" Content="Tìm &amp; Thay thế (Replace)" 
                                                 FontWeight="SemiBold" FontSize="11.5" Foreground="#334155"
                                                 Checked="BatchMode_Changed"/>
                                </Grid>

                                <!-- Panel Gán trực tiếp -->
                                <StackPanel x:Name="PanelBatchDirect" Visibility="Visible">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Giá trị mới:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtBatchNewValue" Grid.Column="1" Text="" FontWeight="Bold" Foreground="#0284C7"
                                                 TextChanged="BatchRule_Changed"
                                                 ToolTip="Nhập giá trị mới cần gán (ví dụ: A1, 24VDC, OMRON...)"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Panel Tìm & Thay thế -->
                                <StackPanel x:Name="PanelBatchReplace" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tìm chuỗi:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtBatchFindText" Grid.Column="1" Text="" 
                                                 TextChanged="BatchRule_Changed"
                                                 ToolTip="Chuỗi con cần tìm trong giá trị Attribute hiện tại (ví dụ: 14)"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Thay bằng:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtBatchReplaceText" Grid.Column="1" Text="" FontWeight="Bold" Foreground="#0284C7"
                                                 TextChanged="BatchRule_Changed"
                                                 ToolTip="Chuỗi mới thay thế vào (ví dụ: A1)"/>
                                    </Grid>
                                    <CheckBox x:Name="ChkBatchMatchCase" Content="Phân biệt chữ hoa / chữ thường" 
                                              FontSize="11" Margin="90,0,0,4" Foreground="#64748B"
                                              Checked="BatchRule_Changed" Unchecked="BatchRule_Changed"/>
                                </StackPanel>

                                <!-- Box Preview -->
                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,4,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Xem trước: " FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblBatchPreview" Text="(Nhập giá trị để xem trước)" FontWeight="Bold" FontSize="12.5" Foreground="#15803D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="350"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnBatchApply" Grid.Column="0" Content="⚡ QUÉT CHỌN &amp; ĐỔI HÀNG LOẠT" 
                                    Style="{StaticResource PrimaryButton}" Height="36" Click="BtnBatchApply_Click"/>
                            <Button x:Name="BtnBatchPickOneByOne" HorizontalContentAlignment="Center" Grid.Column="2" 
                                    Content="👆 Click từng cái" Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0" 
                                    ToolTip="Click chuột liên tục vào từng Block để đổi giá trị Attribute" 
                                    Click="BtnBatchPickOneByOne_Click"/>
                        </Grid>

                        <TextBlock x:Name="TxtBatchStatus" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,10">
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="TxtFooterTip" Text="💡 Mẹo: Nhấn 'Chọn TAG' rồi click vào đối tượng trên CAD để tự điền tên Block và TAG." 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Left"
                   FontSize="11" 
                   Margin="0,0,0,8"       
                   Foreground="#64748B"
                   TextWrapping="Wrap"/>
                <Button Content="Đóng (Hoàn tất)" 
                Style="{StaticResource SecondaryButton}" 
                HorizontalAlignment="Right" 
                Width="105" 
                Click="BtnClose_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>
