<Window x:Class="CadElectricalToolkit.UI.Views.AutoNumberingWindow"
        xmlns:comp="clr-namespace:CadElectricalToolkit.UI.Components"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ĐÁNH SỐ THỨ TỰ &amp; QUẢN LÝ ATTRIBUTE" 
        Height="735" Width="575"
        MinHeight="680" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#0F1117"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ═══════════════ MODERN DARK THEME ═══════════════ -->

        <!-- Modern Card Panel -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#181B26"/>
            <Setter Property="BorderBrush" Value="#2B3245"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Headers -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="RedSectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="GreenSectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#4ADE80"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- CheckBox & RadioButton Dark Theme -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Modern Clean Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="29"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#12151E"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#2B3245"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="bd" Property="Background" Value="#161825"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ SLIM MODERN DARK SCROLLBAR ═══════════════ -->

        <!-- ScrollBar Thumb Style -->
        <Style x:Key="ModernScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder"
                                Background="#333C52"
                                CornerRadius="3"
                                Margin="1,0,1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transparent Page Button for ScrollTrack -->
        <Style x:Key="ModernScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default Slim Modern ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="7"/>
                    <Setter Property="MinWidth" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ModernScrollBarPageButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ModernScrollBarPageButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="MinHeight" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ModernScrollBarPageButton}" Command="{x:Static ScrollBar.PageLeftCommand}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ModernScrollBarPageButton}" Command="{x:Static ScrollBar.PageRightCommand}"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════ MODERN DARK COMBOBOX ═══════════════ -->

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="10,0"
                                Margin="2,1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#252D40"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="itemBorder" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Template for ComboBox -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="toggleBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="Transparent">
                        <Path x:Name="arrow"
                              Data="M 1 1.5 L 4.5 5 L 8 1.5"
                              Stroke="#94A3B8"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="toggleBorder" Property="BorderBrush" Value="#3B82F6"/>
                    <Setter TargetName="toggleBorder" Property="Background" Value="#161825"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#38BDF8"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="toggleBorder" Property="BorderBrush" Value="#3B82F6"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#38BDF8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="toggleBorder" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBox Default Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="29"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Background" Value="#12151E"/>
            <Setter Property="BorderBrush" Value="#2B3245"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="#38BDF8"
                                     FontSize="{TemplateBinding FontSize}"
                                     FontWeight="{TemplateBinding FontWeight}"
                                     Margin="8,0,28,0"
                                     Padding="2,0,0,0"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     Focusable="True"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#161924"
                                        BorderBrush="#2E364A"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="3"
                                        Margin="0,3,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.55" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ BUTTONS & TABS ═══════════════ -->

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2230"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#2E354A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#282F42"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161B28"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Tab Styling -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="#12151E" Padding="14,8" 
                                CornerRadius="6" Margin="0,0,4,0" BorderBrush="#252B3B" BorderThickness="1">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#252D40"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Tech Blue Preview Panel -->
        <Style x:Key="PreviewPanel" TargetType="Border">
            <Setter Property="Background" Value="#0B1A2F"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ HEADER ═══════════════ -->
        <Border Grid.Row="0" Background="#141722" Padding="16,8" BorderBrush="#1F2433" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <comp:AppLogo Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ĐÁNH SỐ THỨ TỰ &amp; QUẢN LÝ ATTRIBUTE" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13.5"/>
                    <TextBlock Text="Hỗ trợ Khung tên, Block Attribute, Đổi &amp; Xoay Tag, Dây liên trang To-From" Foreground="#94A3B8" FontSize="10.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ TABS ═══════════════ -->
        <TabControl Grid.Row="1" Margin="8,6,8,2" 
                    Background="Transparent" BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- ══════════ TAB 1: STT KHUNG TÊN ══════════ -->
            <TabItem Header="STT khung tên" FontWeight="SemiBold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Padding="0,0,4,16">
                    <StackPanel>
                        <!-- Quy tắc đánh số -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Quy tắc đánh số thứ tự" Style="{StaticResource SectionHeader}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Prefix" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding FramePrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Kiểu đánh số" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedIndex="{Binding FrameNumberStyleIndex}">
                                            <ComboBoxItem Content="1,2,3,..."/>
                                            <ComboBoxItem Content="A,B,C,..."/>
                                            <ComboBoxItem Content="I,II,III,..."/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Suffix" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding FrameSuffix, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,4,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="From:" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding FrameFromText, UpdateSourceTrigger=PropertyChanged}" 
                                             TextAlignment="Center"/>
                                    <CheckBox Grid.Column="3" Content="Sử dụng hai chữ số (01, 02...)" 
                                              IsChecked="{Binding FrameTwoDigits}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Preview Badge -->
                                <Border Style="{StaticResource PreviewPanel}">
                                    <DockPanel>
                                        <TextBlock Text="Xem trước: " FontWeight="SemiBold" Foreground="#93C5FD" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FramePreview}" FontWeight="Bold" FontSize="14.5" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Cài đặt tổng trang TSHEET -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Cài đặt tổng số trang (TSHEET)" Style="{StaticResource SectionHeader}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="Cập nhật tổng trang (TSHEET)" IsChecked="{Binding FramePageMode}" 
                                              FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                        <TextBlock Text="Tag:" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding FrameTotalPagesTag, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="60" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                        <TextBlock Text="Ký tự:" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding FrameTotalPagesPrefix, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="30" TextAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="Tự tính theo số khung chọn" IsChecked="{Binding FrameAutoTotal}" 
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                                        <TextBlock Text="Cố định:" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                        <TextBox Text="{Binding FrameTotalPagesText, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="48" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding FramePagePreview}" FontStyle="Italic" FontSize="11" 
                                           Foreground="#38BDF8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Thông tin khung tên -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Thông tin khung tên mục tiêu" Style="{StaticResource SectionHeader}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Block name:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding FrameBlockName, UpdateSourceTrigger=PropertyChanged}" 
                                             FontWeight="Bold" Foreground="#38BDF8"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Attribute TAG:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding FrameAttrTag, UpdateSourceTrigger=PropertyChanged}" 
                                             FontWeight="Bold" Foreground="#38BDF8"/>
                                    <Button Grid.Column="2" Width="85" Content="🎯 Chọn TAG" 
                                             Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                             Command="{Binding FrameChooseTagCommand}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hướng:" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding FrameDirectionIndex}">
                                        <ComboBoxItem Content="1. Trái => Phải | Trên => Dưới"/>
                                        <ComboBoxItem Content="2. Trái => Phải | Dưới => Trên"/>
                                        <ComboBoxItem Content="3. Trên => Dưới | Trái => Phải"/>
                                        <ComboBoxItem Content="4. Dưới => Trên | Trái => Phải"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action -->
                        <Button Content="⚡ QUÉT CHỌN &amp; ÁP DỤNG CHO KHUNG TÊN" 
                                Style="{StaticResource PrimaryButton}" Margin="0,2,0,4"
                                Command="{Binding FrameSelectBlocksCommand}"/>
                        <TextBlock Text="{Binding FrameStatus}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#4ADE80" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════ TAB 2: STT BLOCK ATTRIBUTE ══════════ -->
            <TabItem Header="STT block attribute" FontWeight="SemiBold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Padding="0,0,4,16">
                    <StackPanel>
                        <!-- Quy tắc đánh số -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Quy tắc đánh số thứ tự" Style="{StaticResource SectionHeader}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Prefix" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding AttrPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Kiểu đánh số" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedIndex="{Binding AttrNumberStyleIndex}">
                                            <ComboBoxItem Content="1,2,3,..."/>
                                            <ComboBoxItem Content="A,B,C,..."/>
                                            <ComboBoxItem Content="I,II,III,..."/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Suffix" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding AttrSuffix, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="From:" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding AttrFromText, UpdateSourceTrigger=PropertyChanged}" 
                                             TextAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Bước:" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="4" Text="{Binding AttrStepText, UpdateSourceTrigger=PropertyChanged}" 
                                             TextAlignment="Center"/>
                                    <CheckBox Grid.Column="6" Content="Hai chữ số (01...)" 
                                              IsChecked="{Binding AttrTwoDigits}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Preview Badge -->
                                <Border Style="{StaticResource PreviewPanel}">
                                    <DockPanel>
                                        <TextBlock Text="Xem trước: " FontWeight="SemiBold" Foreground="#93C5FD" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AttrPreview}" FontWeight="Bold" FontSize="14.5" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Đối tượng mục tiêu -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Đối tượng mục tiêu" Style="{StaticResource SectionHeader}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Block name:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding AttrBlockName, UpdateSourceTrigger=PropertyChanged}" 
                                             FontWeight="SemiBold" ToolTip="Tên Block mục tiêu (để trống nếu áp dụng mọi block)"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Attribute TAG:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding AttrTagName, UpdateSourceTrigger=PropertyChanged}" 
                                             FontWeight="Bold" Foreground="#38BDF8"/>
                                    <Button Grid.Column="2" Width="85" Content="🎯 Chọn TAG" 
                                             Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                             Command="{Binding AttrChooseTagCommand}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hướng:" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding AttrDirectionIndex}">
                                        <ComboBoxItem Content="1. Trái => Phải | Trên => Dưới"/>
                                        <ComboBoxItem Content="2. Trái => Phải | Dưới => Trên"/>
                                        <ComboBoxItem Content="3. Trên => Dưới | Trái => Phải"/>
                                        <ComboBoxItem Content="4. Dưới => Trên | Trái => Phải"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox Content="Hỗ trợ cả Text/MText nếu không tìm thấy Attribute" 
                                          IsChecked="{Binding AttrIncludeText}" FontSize="11" Margin="90,4,0,0" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="⚡ QUÉT CHỌN &amp; ÁP DỤNG HÀNG LOẠT" 
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AttrSelectBlocksCommand}"/>
                            <Button Grid.Column="2" Content="👆 Click từng cái" 
                                    Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0"
                                    Command="{Binding AttrPickOneByOneCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding AttrStatus}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#4ADE80" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════ TAB 3: ĐỔI ATTRIBUTE HÀNG LOẠT ══════════ -->
            <TabItem Header="Đổi Attribute hàng loạt" FontWeight="SemiBold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Padding="0,0,4,16">
                    <StackPanel>
                        <!-- Nhóm 1: Block & Attribute mục tiêu -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Block &amp; Attribute mục tiêu" Style="{StaticResource SectionHeader}"/>

                                <!-- Nút chọn mẫu CAD -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="  🎯 Chọn Block mẫu trên CAD  " 
                                            Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" 
                                            Command="{Binding BatchPickSampleCommand}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BatchSampleInfo}" 
                                               FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <!-- Block name -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Block name:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding BatchBlockName, UpdateSourceTrigger=PropertyChanged}" 
                                             FontWeight="SemiBold" ToolTip="Tên Block mục tiêu (để trống nếu muốn áp dụng cho mọi block có chứa TAG đã chọn)"/>
                                    <Button Grid.Column="2" Content="  Tất cả  " 
                                            Style="{StaticResource SecondaryButton}" Height="28" Padding="8,0" Margin="4,0,0,0" 
                                            Command="{Binding BatchClearBlockNameCommand}"/>
                                </Grid>

                                <!-- Attribute TAG -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Attribute TAG:" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" IsEditable="True" 
                                              FontWeight="Bold" Foreground="#38BDF8"
                                              ItemsSource="{Binding BatchTagList}"
                                              Text="{Binding BatchAttrTag, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- Giá trị hiện tại -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Giá trị hiện tại:" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BatchSampleVal}" 
                                               FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Nhóm 2: Nội dung cần đổi -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Nội dung cần đổi" Style="{StaticResource SectionHeader}"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Content="1. Gán giá trị mới cố định" 
                                                 IsChecked="{Binding BatchModeDirect}" FontWeight="SemiBold" 
                                                 FontSize="11.5" Foreground="#CBD5E1" GroupName="BatchMode"/>
                                    <RadioButton Grid.Column="1" Content="2. Tìm &amp; Thay thế (Replace)" 
                                                 IsChecked="{Binding BatchModeReplace}" FontWeight="SemiBold" 
                                                 FontSize="11.5" Foreground="#CBD5E1" GroupName="BatchMode"/>
                                </Grid>

                                <!-- Panel Gán trực tiếp -->
                                <StackPanel Visibility="{Binding BatchModeDirect, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Giá trị mới:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding BatchNewValue, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Panel Tìm & Thay thế -->
                                <StackPanel Visibility="{Binding BatchModeReplace, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tìm chuỗi:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding BatchFindText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Thay bằng:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding BatchReplaceText, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Grid>
                                    <CheckBox Content="Phân biệt chữ hoa / chữ thường" IsChecked="{Binding BatchMatchCase}"
                                              FontSize="11" Margin="90,0,0,4" Foreground="#94A3B8"/>
                                </StackPanel>

                                <!-- Preview -->
                                <Border Style="{StaticResource PreviewPanel}">
                                    <DockPanel>
                                        <TextBlock Text="Xem trước: " FontWeight="SemiBold" Foreground="#93C5FD" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding BatchPreview}" FontWeight="Bold" FontSize="12.5" 
                                                   Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="⚡ QUÉT CHỌN &amp; ĐỔI HÀNG LOẠT" 
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BatchApplyCommand}"/>
                            <Button Grid.Column="2" Content="👆 Click từng cái" 
                                    Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0"
                                    Command="{Binding BatchPickOneByOneCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding BatchStatus}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#4ADE80" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════ TAB 4: XOAY ATTRIBUTE HÀNG LOẠT ══════════ -->
            <TabItem Header="Xoay Attribute" FontWeight="SemiBold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Padding="0,0,4,16">
                    <StackPanel>
                        <!-- Nhóm 1: Block & Attribute mục tiêu -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Block &amp; Attribute mục tiêu" Style="{StaticResource SectionHeader}"/>

                                <!-- Nút chọn mẫu CAD -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="  🎯 Chọn Block / TAG mẫu trên CAD  " 
                                            Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" 
                                            Command="{Binding RotatePickSampleCommand}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RotateSampleInfo}" 
                                               FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <!-- Block name -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Block name:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding RotateBlockName, UpdateSourceTrigger=PropertyChanged}" 
                                             FontWeight="SemiBold" ToolTip="Tên Block mục tiêu (để trống nếu muốn áp dụng cho mọi block có chứa TAG đã chọn)"/>
                                    <Button Grid.Column="2" Content="  Tất cả  " 
                                            Style="{StaticResource SecondaryButton}" Height="28" Padding="8,0" Margin="4,0,0,0" 
                                            Command="{Binding RotateClearBlockNameCommand}"/>
                                </Grid>

                                <!-- Attribute TAG -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Attribute TAG:" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" IsEditable="True" 
                                              FontWeight="Bold" Foreground="#38BDF8"
                                              ItemsSource="{Binding RotateTagList}"
                                              Text="{Binding RotateAttrTag, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="2" Width="85" Content="🎯 Chọn TAG" 
                                            Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                            Command="{Binding RotatePickTagCommand}"/>
                                </Grid>

                                <!-- Góc hiện tại của mẫu -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Góc hiện tại:" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RotateSampleAngleText}" 
                                               FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </Grid>

                                <CheckBox Content="Giữ tâm chữ không đổi (Căn giữa vị trí gốc ban đầu)" 
                                          IsChecked="{Binding RotateKeepCenter}" FontWeight="SemiBold" 
                                          Foreground="#38BDF8" Margin="90,4,0,3"
                                          ToolTip="Tự động giữ nguyên điểm tâm của chữ khi xoay (không bị trôi hay tụt xuống dưới)"/>

                                <!-- Khoảng cách hở (Offset) -->
                                <Grid Margin="90,3,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Khoảng cách hở (Offset):" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding RotateOffset, UpdateSourceTrigger=PropertyChanged}" 
                                             FontWeight="Bold" Foreground="#38BDF8" TextAlignment="Center" Height="26"
                                             ToolTip="Khoảng cách đẩy chữ hở ra khỏi linh kiện / đường dây (đơn vị bản vẽ CAD, ví dụ: 2)"/>
                                    <TextBlock Grid.Column="2" Text="(Đẩy hở ra khỏi linh kiện, ví dụ: 2)" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <CheckBox Content="Hỗ trợ cả Text/MText tự do trong vùng chọn" 
                                          IsChecked="{Binding RotateIncludeText}" FontSize="11" Margin="90,2,0,0" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>

                        <!-- Nhóm 2: Tùy chọn góc xoay -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Tùy chọn góc xoay" Style="{StaticResource SectionHeader}"/>

                                <!-- Chế độ xoay -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Content="1. Góc tuyệt đối (Cố định)" 
                                                 IsChecked="{Binding RotateModeAbsolute}" FontWeight="SemiBold" 
                                                 FontSize="11.5" Foreground="#CBD5E1" GroupName="RotateMode"/>
                                    <RadioButton Grid.Column="1" Content="2. Xoay tương đối (Cộng góc)" 
                                                 IsChecked="{Binding RotateModeRelative}" FontWeight="SemiBold" 
                                                 FontSize="11.5" Foreground="#CBD5E1" GroupName="RotateMode"/>
                                </Grid>

                                <!-- Phím chọn nhanh hướng xoay -->
                                <TextBlock Text="Chọn nhanh hướng xoay:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                    <Button Content="⬆️ 90° (Dọc lên)" Style="{StaticResource SecondaryButton}" Height="30" Margin="0,0,3,0"
                                            Command="{Binding RotateSetAnglePresetCommand}" CommandParameter="90"/>
                                    <Button Content="⬇️ 270° (Dọc xuống)" Style="{StaticResource SecondaryButton}" Height="30" Margin="2,0,2,0"
                                            Command="{Binding RotateSetAnglePresetCommand}" CommandParameter="270"/>
                                    <Button Content="➡️ 0° (Ngang)" Style="{StaticResource SecondaryButton}" Height="30" Margin="2,0,2,0"
                                            Command="{Binding RotateSetAnglePresetCommand}" CommandParameter="0"/>
                                    <Button Content="⬅️ 180° (Ngang lật)" Style="{StaticResource SecondaryButton}" Height="30" Margin="3,0,0,0"
                                            Command="{Binding RotateSetAnglePresetCommand}" CommandParameter="180"/>
                                </UniformGrid>

                                <!-- Nhập góc & Lấy góc từ CAD -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Góc xoay (°):" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding RotateAngleText, UpdateSourceTrigger=PropertyChanged}" 
                                             FontWeight="Bold" Foreground="#38BDF8" TextAlignment="Center"/>
                                    <Button Grid.Column="2" Content="  📐 Lấy góc từ CAD  " 
                                            Style="{StaticResource SecondaryButton}" Height="29" Padding="8,0" Margin="6,0,0,0"
                                            Command="{Binding RotatePickAngleCommand}"/>
                                </Grid>

                                <!-- Preview -->
                                <Border Style="{StaticResource PreviewPanel}">
                                    <DockPanel>
                                        <TextBlock Text="Xem trước: " FontWeight="SemiBold" Foreground="#93C5FD" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RotatePreview}" FontWeight="Bold" FontSize="12.5" 
                                                   Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="⚡ QUÉT CHỌN &amp; XOAY HÀNG LOẠT" 
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RotateApplyCommand}"/>
                            <Button Grid.Column="2" Content="👆 Click từng cái" 
                                    Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0"
                                    Command="{Binding RotatePickOneByOneCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding RotateStatus}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#4ADE80" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════ TAB 5: DÂY LIÊN TRANG (TO-FROM) ══════════ -->
            <TabItem Header="Dây liên trang (To-From)" FontWeight="SemiBold" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Padding="0,0,4,16">
                    <StackPanel>
                        <!-- Nhóm 1: Nhận diện Block Mũi tên & Attribute -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Nhận diện Mũi tên tín hiệu &amp; TAG dây" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                                    <Button Content="🎯 Chọn mẫu trên CAD" Style="{StaticResource SecondaryButton}" 
                                            Height="27" Padding="10,0" HorizontalAlignment="Right"
                                            Command="{Binding WirePickSampleCommand}"
                                            ToolTip="Click vào một block mũi tên trên bản vẽ để tự động nhận diện Block và các TAG"/>
                                </DockPanel>

                                <!-- Tên Block mũi tên -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tên Block:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding WireBlockName, UpdateSourceTrigger=PropertyChanged}" 
                                             FontWeight="SemiBold" ToolTip="Tên Block mũi tên (ví dụ: Arrow - To - Block, để trống để áp dụng cho mọi block mũi tên)"/>
                                    <Button Grid.Column="2" Content="  Tất cả  " 
                                            Style="{StaticResource SecondaryButton}" Height="28" Padding="8,0" Margin="4,0,0,0" 
                                            Command="{Binding WireClearBlockNameCommand}"/>
                                </Grid>

                                <!-- TAG Tên dây / Tín hiệu -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TAG Tên dây:" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" IsEditable="True" 
                                              FontWeight="Bold" Foreground="#38BDF8"
                                              ItemsSource="{Binding WireTagList}"
                                              Text="{Binding WireTag, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="TAG chứa mã/tên dây dẫn (trong bản vẽ của bạn: WIRE_NAME, ví dụ: 24VP, DI.19)"/>
                                    <Button Grid.Column="2" Width="85" Content="🎯 Chọn TAG" 
                                            Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                            Command="{Binding WirePickTagCommand}"/>
                                </Grid>

                                <!-- TAG Địa chỉ To & From -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TAG Địa chỉ:" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Nguồn (TO):" FontSize="10.5" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <ComboBox IsEditable="True" FontWeight="SemiBold"
                                                  ItemsSource="{Binding WireAddrToTagList}"
                                                  Text="{Binding WireAddrToTag, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="TAG ghi vị trí trang đích (trong bản vẽ của bạn: ADDRESS_TO)"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Đích (FROM):" FontSize="10.5" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <ComboBox IsEditable="True" FontWeight="SemiBold"
                                                  ItemsSource="{Binding WireAddrFromTagList}"
                                                  Text="{Binding WireAddrFromTag, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="TAG ghi vị trí trang nguồn (thường là ADDRESS_FROM hoặc ADDRESS_TO)"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Nhóm 2: Định dạng hiển thị địa chỉ trang -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Định dạng địa chỉ tham chiếu liên trang" Style="{StaticResource SectionHeader}"/>

                                <!-- Kiểu hiển thị -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Row="0" Grid.Column="0" Content="1. Chỉ số trang (02)" 
                                                 IsChecked="{Binding WireFormatSheetOnly}" FontWeight="SemiBold" Margin="0,0,0,6"
                                                 ToolTip="Chỉ hiển thị số trang đích (ví dụ: 02)"/>
                                    <RadioButton Grid.Row="0" Grid.Column="1" Content="2. Trang - Ô lưới (02-5B)" 
                                                 IsChecked="{Binding WireFormatSheetGrid}" FontWeight="SemiBold" Margin="0,0,0,6"
                                                 ToolTip="Hiển thị số trang kèm tọa độ hàng/cột (ví dụ: 02-5B)"/>
                                    <RadioButton Grid.Row="1" Grid.Column="0" Content="3. Trang / Tổng (02/07)" 
                                                 IsChecked="{Binding WireFormatSheetTotal}" FontWeight="SemiBold"
                                                 ToolTip="Hiển thị số trang trên tổng số trang (ví dụ: 02/07)"/>
                                    <RadioButton Grid.Row="1" Grid.Column="1" Content="4. Tùy biến định dạng" 
                                                 IsChecked="{Binding WireFormatCustom}" FontWeight="SemiBold"
                                                 ToolTip="Tùy biến Prefix, Suffix và Dấu phân cách"/>
                                </Grid>

                                <!-- Tùy chọn chi tiết -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tiền tố (Prefix):" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding WirePrefix, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Dấu nối ô lưới:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding WireGridSeparator, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Hậu tố (Suffix):" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding WireSuffix, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Số trang 2 chữ số (01, 02, ...)" 
                                          IsChecked="{Binding WireTwoDigits}" FontWeight="SemiBold" 
                                          Foreground="#38BDF8" Margin="0,2,0,4"/>

                                <CheckBox Content="Gộp nhiều trang đích bằng dấu phẩy (, ) khi dây rẽ nhánh" 
                                          IsChecked="{Binding WireIncludeMultiSheets}" FontSize="11" 
                                          Foreground="#94A3B8" Margin="0,0,0,4"/>

                                <CheckBox Content="Khớp theo tên gốc (Bỏ qua đuôi sau '-' ví dụ: DI.08-RB1 khớp DI.08-RB2)" 
                                          IsChecked="{Binding WireMatchBaseName}" FontSize="11" 
                                          Foreground="#38BDF8" Margin="0,0,0,4"
                                          ToolTip="Tự động ghép đôi các dây có cùng phần đầu tín hiệu (ví dụ: DI.08) dù hậu tố trạm khác nhau (-RB1, -RB2)"/>

                                <CheckBox Content="Đồng bộ 2 chiều (Cả Nguồn ⟷ Đích)" 
                                          IsChecked="{Binding WireUpdateBothWays}" FontSize="11" 
                                          Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>

                        <!-- Nhóm 3: Khung xem trước -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Xem trước kết quả" Style="{StaticResource SectionHeader}"/>
                                <Border Style="{StaticResource PreviewPanel}">
                                    <DockPanel>
                                        <TextBlock Text="Định dạng địa chỉ ghi vào TAG: " FontWeight="SemiBold" Foreground="#93C5FD" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding WirePreview}" FontWeight="Bold" FontSize="14" 
                                                   Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="⚡ ĐỒNG BỘ TOÀN BỘ BẢN VẼ" 
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding WireSyncAllCommand}"
                                    ToolTip="Tự động quét tất cả các trang trong ModelSpace và đồng bộ địa chỉ dây hàng loạt"/>
                            <Button Grid.Column="2" Content="🎯 Quét chọn vùng" 
                                    Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0"
                                    Command="{Binding WireSyncSelectedCommand}"
                                    ToolTip="Quét chuột chọn các mũi tên hoặc khung bản vẽ cụ thể trên CAD"/>
                            <Button Grid.Column="4" Content="🔗 Nối 2 mũi tên" 
                                    Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0"
                                    Command="{Binding WireConnectTwoCommand}"
                                    ToolTip="Click chọn Mũi tên A rồi click chọn Mũi tên B để gắn liên kết thủ công"/>
                        </Grid>

                        <TextBlock Text="{Binding WireStatus}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#4ADE80" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════════ FOOTER ═══════════════ -->
        <Border Grid.Row="2" Background="#111318" BorderBrush="#1F2433" BorderThickness="0,1,0,0" Padding="14,8">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding FooterTip}" VerticalAlignment="Center" HorizontalAlignment="Left"
                           FontSize="11" Margin="0,0,0,6" Foreground="#64748B" TextWrapping="Wrap"/>
                <Button Content="Đóng (Hoàn tất)" Style="{StaticResource SecondaryButton}" 
                        HorizontalAlignment="Right" Width="115"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
